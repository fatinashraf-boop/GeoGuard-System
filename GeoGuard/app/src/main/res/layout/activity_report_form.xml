<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F7FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="New Incident Report"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#172B4D" />

        <!-- Incident Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Incident Title"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#172B4D" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:boxBackgroundColor="#FFFFFF"
            app:boxStrokeColor="#1746A2"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etReportTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter incident title"
                android:textColor="#172B4D"
                android:textColorHint="#6B778C"
                android:padding="14dp"
                android:inputType="textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Incident Type -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Incident Type"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#172B4D" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:boxBackgroundColor="#FFFFFF"
            app:boxStrokeColor="#1746A2"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etReportType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. Property Damage, Safety Hazard"
                android:textColor="#172B4D"
                android:textColorHint="#6B778C"
                android:padding="14dp"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Description"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#172B4D" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:boxBackgroundColor="#FFFFFF"
            app:boxStrokeColor="#1746A2"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etReportDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Provide detailed description of the incident"
                android:textColor="#172B4D"
                android:textColorHint="#6B778C"
                android:padding="14dp"
                android:minLines="3"
                android:gravity="top"
                android:inputType="textMultiLine" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Location Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Location Details"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#172B4D" />

        <Button
            android:id="@+id/btnGetLocation"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:text="Get Current Location"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#1746A2" />

        <TextView
            android:id="@+id/tvReportLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:text="Location not captured"
            android:textColor="#172B4D"
            android:textSize="14sp" />

        <!-- Evidence Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Evidence Photo"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#172B4D" />

        <Button
            android:id="@+id/btnCaptureEvidence"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:text="Capture Evidence Photo"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#1746A2" />

        <TextView
            android:id="@+id/tvReportEvidence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:text="No evidence photo"
            android:textColor="#172B4D"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/progressSubmit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnSubmitReport"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="Submit Report"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#1746A2" />

        <TextView
            android:id="@+id/tvReportMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="8dp"
            android:textColor="#C62828"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>